      "festive": "Festive"
    },
    "garment_type": {
      "tshirt": "T-shirt",
      "graphic_tshirt": "Graphic T-shirt",
      "ringer_tshirt": "Ringer T-shirt",
      "raglan_tshirt": "Raglan T-shirt",
