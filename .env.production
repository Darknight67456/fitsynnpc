# Production build settings that are safe to commit (no secrets here).
# Vite reads this file during `npm run build`, so Netlify uses it without any dashboard setup.
# Netlify environment variables with the same name still take priority.

# AI try-on calls the Supabase "catvton-tryon" edge function, which runs CatVTON on RunPod.
# Set to "mock" to stop all GPU calls from the deployed site.
VITE_TRYON_MODE=edge_function
