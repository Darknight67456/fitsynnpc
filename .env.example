# Copy to .env and fill in. Never put RunPod or service-role keys here: every VITE_* value ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FitSync AI service (ai/service, FastAPI). Defaults to http://localhost:8000 when empty.
VITE_AI_URL=

# AI try-on backend: 'mock' (default, no GPU) or 'edge_function' (Supabase catvton-tryon -> RunPod).
# Switch to edge_function only after the RunPod endpoint and the edge function are deployed and tested.
VITE_TRYON_MODE=mock
